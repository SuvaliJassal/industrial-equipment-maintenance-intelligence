# Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# SQLite database files generated locally
*.db
*.db-journal
*.db-shm
*.db-wal

# Raw and processed local data
data/raw/*.csv
data/processed/*.csv
data/database/*.db

# Power BI generated exports
powerbi/data_exports/*.csv

# Keep Power BI project file
!powerbi/*.pbix

# Model and metric artifacts generated locally
artifacts/models/*
artifacts/metrics/*
!artifacts/models/.gitkeep
!artifacts/metrics/.gitkeep

# Keep dashboard screenshots
!artifacts/visuals/*.png

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/
